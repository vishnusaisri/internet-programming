<!DOCTYPE html>
<html>
<head>
<title>CSS Layout Debugging</title>
<link rel="stylesheet" href="style.css">
</head>

<body>

<header>
<h1>My Website</h1>
</header>

<nav>
<a href="#">Home</a>
<a href="#">About</a>
<a href="#">Services</a>
<a href="#">Contact</a>
</nav>

<div class="container">

<div class="content">
<h2>Main Content</h2>
<p>This section displays the webpage content.</p>
</div>

<div class="sidebar">
<h3>Sidebar</h3>
<p>Additional Information</p>
</div>

</div>

<footer>
Copyright © 2026
</footer>

</body>
*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:Arial;
background:#f2f2f2;
}

header{
background:#333;
color:white;
padding:20px;
text-align:center;
}

nav{
display:flex;
justify-content:center;
background:#555;
}

nav a{
color:white;
padding:15px;
text-decoration:none;
}

.container{
display:flex;
gap:20px;
padding:20px;
}

.content{
flex:3;
background:white;
padding:20px;
}

.sidebar{
flex:1;
background:#ddd;
padding:20px;
}

footer{
background:#333;
color:white;
text-align:center;
padding:15px;
margin-top:20px;
}
/* Tablet */

@media(max-width:768px){

.container{
flex-direction:column;
}

nav{
flex-wrap:wrap;
}

}

/* Mobile */

@media(max-width:480px){

nav{
flex-direction:column;
align-items:center;
}

.container{
padding:10px;
}

header,
footer{
font-size:18px;
}

img{
max-width:100%;
height:auto;
}

}

</html>
