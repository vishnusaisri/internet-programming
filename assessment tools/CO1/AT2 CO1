<!DOCTYPE html>
<html>
<head>
<title>Responsive Layout</title>
<link rel="stylesheet" href="style.css">
</head>
<body>

<header>Retail Store</header>

<nav>
<a href="#">Home</a>
<a href="#">Products</a>
<a href="#">Offers</a>
<a href="#">Contact</a>
</nav>

<div class="container">
<div class="content">
<h2>Welcome</h2>
<p>Responsive webpage using Flexbox.</p>
</div>

<div class="sidebar">
<h3>Latest Offers</h3>
<p>Discounts Available</p>
</div>
</div>

<footer>© 2026 Retail Store</footer>

</body>
</html>
CSS
*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:Arial;
}

header,footer{
background:#333;
color:white;
text-align:center;
padding:15px;
}

nav{
display:flex;
justify-content:center;
background:#555;
}

nav a{
color:white;
padding:15px;
text-decoration:none;
}

.container{
display:flex;
gap:20px;
padding:20px;
}

.content{
flex:3;
background:#f4f4f4;
padding:20px;
}

.sidebar{
flex:1;
background:#ddd;
padding:20px;
}

footer{
margin-top:20px;
}
(c) Media Queries
/* Tablet */
@media(max-width:768px){
.container{
flex-direction:column;
}

nav{
flex-wrap:wrap;
}
}

/* Mobile */
@media(max-width:480px){
nav{
flex-direction:column;
}

header,footer{
font-size:18px;
}

.container{
padding:10px;
}
}
